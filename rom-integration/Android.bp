// Material You AOSP Messages — prebuilt module for ROM trees.
// Drop this folder into your tree (e.g. vendor/<rom>/prebuilt/MaterialYouMessages/),
// put the release APK next to it as MaterialYouMessages.apk, and add the modules
// below to PRODUCT_PACKAGES. See README "Shipping in a custom ROM".

android_app_import {
    name: "MaterialYouMessages",
    apk: "MaterialYouMessages.apk",
    // Keep the upstream signature so GitHub releases install as updates over the ROM copy.
    presigned: true,
    product_specific: true,
    // Replace AOSP Messaging (module name "messaging", packages/apps/Messaging).
    overrides: ["messaging"],
    required: [
        "default-permissions-materialyou-messages",
    ],
}

prebuilt_etc {
    name: "default-permissions-materialyou-messages",
    src: "default-permissions-materialyou-messages.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

runtime_resource_overlay {
    name: "MaterialYouMessagesDefaultSmsOverlay",
    resource_dirs: ["overlay/res"],
    manifest: "overlay/AndroidManifest.xml",
    product_specific: true,
}
